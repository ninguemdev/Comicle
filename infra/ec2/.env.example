# Copy to /opt/comicle/.env (chmod 600) and fill in. Never commit the real file.

# Image published by .github/workflows/publish.yml; one commit tag, never a moving one.
COMICLE_IMAGE=ghcr.io/ninguemdev/comicle-dionel:sha-0000000

# Hostname Cloudflare uses to reach this machine (its certificate is in certs/).
ORIGIN_HOST=comicle-origin.dionel.site

# openssl rand -hex 32 (hex, so it needs no escaping in DATABASE_URL)
POSTGRES_PASSWORD=
