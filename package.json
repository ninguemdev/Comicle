{
  "name": "comicle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter @comicle/web --filter @comicle/server dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @comicle/server db:generate",
    "db:migrate": "pnpm --filter @comicle/server db:migrate",
    "avatars:check": "pnpm --filter @comicle/web avatars:check",
    "avatars:generate": "pnpm --filter @comicle/web avatars:generate",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
