{
  "name": "@comicle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "node -e \"console.log('db:generate disponível na T04')\"",
    "db:migrate": "node -e \"console.log('db:migrate disponível na T04')\""
  },
  "dependencies": {
    "@comicle/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
