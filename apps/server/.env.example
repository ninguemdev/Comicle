PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://comicle:comicle@localhost:5432/comicle
DATABASE_URL_TEST=postgres://comicle:comicle@localhost:5432/comicle_test
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_PATH=/
# Path to the web build to serve statically in production (empty = do not serve).
SERVE_WEB_DIST=
LOG_LEVEL=info
# true behind a reverse proxy (real client IP for rate limiting).
TRUST_PROXY=false
# default | fast (short durations for E2E and manual tests; refused in production).
GAME_TIMING_PROFILE=default
